{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/billing-digest",  "schedule": "0 15 * * *" },
    { "path": "/api/nudge?morning=1", "schedule": "30 15 * * *" },
    { "path": "/api/nudge?loose=1",   "schedule": "0 22 * * *" },
    { "path": "/api/nudge",           "schedule": "*/15 * * * *" },
    { "path": "/api/todoist",         "schedule": "*/15 * * * *" },
    { "path": "/api/send-scheduled",  "schedule": "*/5 * * * *" }
  ]
}
